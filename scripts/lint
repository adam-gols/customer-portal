#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm is required. Install: https://pnpm.io/installation"
  exit 1
fi

if [[ ! -d node_modules ]]; then
  pnpm install
fi

pnpm lint
"$(dirname "$0")/validate-brand"
