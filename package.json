{
  "name": "customer-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port ${APP_PORT:-3000}",
    "build": "next build",
    "start": "next start --port ${APP_PORT:-3000}",
    "test": "vitest run",
    "lint": "eslint . && prettier --check \"app/**/*.{ts,tsx,css}\" \"src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"src/**/*.{ts,tsx,css}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "next": "^15.3.4",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^18.3.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  }
}
