# Real values live in 1Password Environment — mount to .env (see docs/secrets.md)
# Do NOT copy this file to .env; use 1Password Environment mount instead.

# Application
APP_ENV=development
APP_PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/customer_portal

# Auth (custom session — min 32 characters)
SESSION_SECRET=replace_me_with_at_least_32_random_characters

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
